# Ce fichier contient les valeurs par défaut pour le développement.
# NE PAS mettre de secrets de production ici.
# Pour les valeurs locales, créer un fichier .env.local (jamais commité).
#
# En production, définir ces variables directement sur le serveur.

###> symfony/framework-bundle ###
APP_ENV=dev
# Remplacer par un secret fort en production (dans .env.local ou variable serveur)
APP_SECRET=48096007c7a644977ddbf94b3845a2d6
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
# En développement, la base de données est gérée par Docker (voir compose.yaml)
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
# En production avec MySQL :
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/portfolio?serverVersion=8.0&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

# URL du frontend React (pour les headers CORS)
FRONTEND_URL=http://localhost:3000
