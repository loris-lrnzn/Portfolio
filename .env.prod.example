# ═══════════════════════════════════════════════════════════════════
# CONFIGURATION DE PRODUCTION — PORTFOLIO
# ═══════════════════════════════════════════════════════════════════
# 1. Copie ce fichier : cp .env.prod.example .env.prod
# 2. Remplis TOUTES les valeurs (remplace les CHANGER_MOI)
# 3. Ne commite JAMAIS .env.prod (il est dans .gitignore)
# ═══════════════════════════════════════════════════════════════════

# ── Symfony ──────────────────────────────────────────────────────────
APP_ENV=prod
# Génère avec : python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=CHANGER_MOI_32_CARACTERES_HEX

DATABASE_URL=mysql://portfolio:CHANGER_MOI_MOT_DE_PASSE_DB@db:3306/portfolio?serverVersion=8.0&charset=utf8mb4

# URL exacte de ton site (sans slash final)
FRONTEND_URL=https://ton-domaine.fr

# ── MySQL ─────────────────────────────────────────────────────────────
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
# Même valeur que dans DATABASE_URL ci-dessus
MYSQL_PASSWORD=CHANGER_MOI_MOT_DE_PASSE_DB
MYSQL_ROOT_PASSWORD=CHANGER_MOI_MOT_DE_PASSE_ROOT

# ── Django Chatbot ────────────────────────────────────────────────────
# Génère avec : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGER_MOI_LONGUE_CLE_ALEATOIRE
DJANGO_DEBUG=False
# Ton domaine + www si applicable
DJANGO_ALLOWED_HOSTS=ton-domaine.fr,www.ton-domaine.fr
CORS_ALLOWED_ORIGINS=https://ton-domaine.fr,https://www.ton-domaine.fr

# Ta clé API Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=ta-cle-gemini
# Optionnel : active la modération OpenAI (gratuite)
OPENAI_API_KEY=
